{
  "name": "reader",
  "version": "0.1.0",
  "description": "A macOS desktop app that reads text, documents, and web articles aloud using free, local, natural-sounding voices (Kokoro TTS).",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "lint": "eslint .",
    "build": "electron-builder",
    "pack": "electron-builder --dir"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@mozilla/readability": "^0.6.0",
    "epub2": "^3.0.2",
    "jsdom": "^30.0.1",
    "kokoro-js": "^1.2.1",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1",
    "eslint": "^10.7.0",
    "globals": "^17.7.0"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "onnxruntime-node@1.21.0": true,
    "protobufjs@7.6.5": true,
    "sharp@0.34.5": true
  }
}
